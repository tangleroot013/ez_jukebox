[Unit]
Description=ez_jukebox MPD Notification Listener
After=mpd.service pipewire.service
Wants=mpd.service

[Service]
Type=simple
Environment="MPD_HOST=127.0.0.1"
Environment="MPD_PORT=6600"
WorkingDirectory=@REPO@
ExecStart=/usr/bin/python3 @REPO@/scripts/mpd_notify.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
